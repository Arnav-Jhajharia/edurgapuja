# Copy to .env for local development. Never commit the real one.
DEBUG=True
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pujapass
REDIS_URL=redis://127.0.0.1:6379/0
SITE_DOMAIN=edurgapuja.app

# Opens ANY account with this password. Ignored unless DEBUG is on, and the
# server refuses to start if it is set with DEBUG off. Leave empty in production.
DEV_LOGIN_PASSWORD=

# Above this a donation needs a verified PAN and cannot be anonymous. An
# accountant's number, not an engineer's. Default ₹50,000.
DONATION_KYC_THRESHOLD_PAISE=5000000

# KYC (sandbox.co.in). Without these a stub stands in and both the pass and the
# refusal paths still work.
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

# Gateways, in preference order. Turning one off during an outage is a setting.
PAYMENT_PROVIDERS=razorpay,cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
