# Copy to .env for local development. Never commit the real one.
DEBUG=True
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pujapass
REDIS_URL=redis://127.0.0.1:6379/0
SITE_DOMAIN=edurgapuja.app

# Opens ANY account with this password. Ignored unless DEBUG is on, and the
# server refuses to start if it is set with DEBUG off. Leave empty in production.
DEV_LOGIN_PASSWORD=
